rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to generate friendship ID
    function getFriendshipId(uid1, uid2) {
      return uid1 < uid2 ? uid1 + '_' + uid2 : uid2 + '_' + uid1;
    }

    // Helper to check if viewers are accepted friends and have category permission enabled
    function hasFriendPermission(viewerId, ownerId, category) {
      let friendshipId = getFriendshipId(viewerId, ownerId);
      return exists(/databases/$(database)/documents/friendships/$(friendshipId)) &&
             get(/databases/$(database)/documents/friendships/$(friendshipId)).data.status == 'accepted' &&
             get(/databases/$(database)/documents/friendships/$(friendshipId)).data.permissions[ownerId][category] == true;
    }

    // Directory mapping of user emails (discovery)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Settings (challenge goals)
    match /users/{userId}/settings/{settingId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (
        request.auth.uid == userId || hasFriendPermission(request.auth.uid, userId, 'challenge')
      );
    }

    // Friendship invites and metadata
    match /friendships/{friendshipId} {
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == resource.data.uid1 || 
        request.auth.uid == resource.data.uid2
      );
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.uid1 || 
        request.auth.uid == request.resource.data.uid2
      );
    }

    // Books catalog
    match /books/{bookId} {
      // Owner has full read/write permissions
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Friends can read only if accepted and permission checkbox is set
      allow read: if request.auth != null && (
        (resource.data.status == 'Wishlist' && hasFriendPermission(request.auth.uid, resource.data.userId, 'wishlist')) ||
        (resource.data.status != 'Wishlist' && resource.data.type == 'Physical' && hasFriendPermission(request.auth.uid, resource.data.userId, 'stacks')) ||
        (resource.data.status != 'Wishlist' && resource.data.type != 'Physical' && hasFriendPermission(request.auth.uid, resource.data.userId, 'archives')) ||
        (resource.data.status != 'Wishlist' && hasFriendPermission(request.auth.uid, resource.data.userId, 'desk')) ||
        (resource.data.status != 'Wishlist' && hasFriendPermission(request.auth.uid, resource.data.userId, 'annals'))
      );
    }
  }
}
